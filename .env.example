# ── Required ─────────────────────────────────────────────────────────────────
CORS_ORIGINS="http://localhost"  
# PostgreSQL connection string
DATABASE_URL=postgres://kollaber:kollaber@localhost:5432/kollaber

# Secret used to sign JWTs — generate with: openssl rand -hex 32
JWT_SECRET=changeme-use-openssl-rand-hex-32

# ── URLs ─────────────────────────────────────────────────────────────────────

# Public URL of the frontend (used for CORS and OAuth redirects)
FRONTEND_URL=http://localhost:3000

# Public URL of the API (used by the frontend to make requests)
API_URL=http://localhost:8080

# ── Email OTP (Resend) ───────────────────────────────────────────────────────
# Create a free account at https://resend.com and generate an API key.
# Without this, OTP codes are printed to stdout (useful for local dev).
RESEND_API_KEY=
RESEND_FROM=Kollaber <noreply@kollaber.io>

# ── GitHub OAuth (optional) ──────────────────────────────────────────────────
# Create an OAuth app at https://github.com/settings/developers
# Set the callback URL to: $API_URL/auth/github/callback

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URL=http://localhost:8080/auth/github/callback

# ── AI features (optional) ───────────────────────────────────────────────────
# Anthropic API key, used for event summaries, postmortems, and the timeline
# assistant. Create one at https://console.anthropic.com/. Without it, the AI
# features return an error but the rest of the app works normally.
ANTHROPIC_API_KEY=

# ── Webhooks (optional) ──────────────────────────────────────────────────────
WEBHOOK_SECRET=

# ── Docker Compose overrides (optional) ─────────────────────────────────────

# Postgres password (default: kollaber — change in production)
DB_PASSWORD=kollaber

# Host ports to bind
API_PORT=8080
UI_PORT=3000
