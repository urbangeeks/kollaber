FROM golang:1.26-alpine AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /kube-watcher ./cmd/kube-watcher

FROM gcr.io/distroless/static:nonroot
COPY --from=builder /kube-watcher /kube-watcher
ENTRYPOINT ["/kube-watcher"]
